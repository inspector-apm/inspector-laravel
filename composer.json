{
    "name": "inspector-apm/inspector-laravel",
    "description": "Code Execution Monitoring, built for developers.",
    "keywords": [
        "monitoring",
        "php",
        "inspector",
        "laravel"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Valerio Barbera",
            "email": "valerio@inspector.dev"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/console": "^12.0|^13.0",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "inspector-apm/inspector-php": "^3.17.0"
    },
    "autoload": {
        "psr-4": {
            "Inspector\\Laravel\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "config": {
        "preferred-install": "dist"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.75",
        "orchestra/testbench": "^10.0|^11.0",
        "livewire/livewire": "^3.7|^4.0",
        "laravel/ai": "^0.10",
        "larastan/larastan": "^3.0",
        "rector/rector": "^1.0|^2.2",
        "tomasvotruba/type-coverage": "^0.2|^2.0"
    },
    "autoload-dev": {
        "psr-4": {
            "Inspector\\Laravel\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": [
            "phpunit --colors=always"
        ],
        "analyse": [
            "vendor/bin/phpstan analyse -v"
        ],
        "format": [
            "@style",
            "@refactor"
        ],
        "style": [
            "php-cs-fixer fix --allow-risky=yes"
        ],
        "refactor": [
            "vendor/bin/rector"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Inspector\\Laravel\\InspectorServiceProvider"
            ],
            "aliases": {
                "Inspector": "Inspector\\Laravel\\Facades\\Inspector"
            }
        }
    }
}
